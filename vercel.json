{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "progress",
  "headers": [
    { "source": "/progress.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ]}
  ]
}
